# Server edition settings. Copy to .env (never commit .env) and replace both passwords with
# different long random strings, e.g. `openssl rand -base64 24`.
DUCK_MYSQL_PASSWORD=replace-with-a-random-long-password
DUCK_MYSQL_ROOT_PASSWORD=replace-with-another-random-long-password

# MySQL InnoDB buffer pool: 128M suits a 1-core / 2 GB server and a circle of friends; 256M on 4 GB.
DUCK_MYSQL_BUFFER_POOL=128M

# HTTPS with automatic certificates (docker-compose.https.yml): point DUCK_DOMAIN and www.DUCK_DOMAIN
# at this server, then uncomment these and set DUCK_BIND=127.0.0.1, DUCK_PORT=8080 below.
# DUCK_DOMAIN=example.com
# COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml

# Public HTTPS address of the site (e.g. https://example.com). Copy-link and poster QR codes use it;
# leave empty until HTTPS works.
DUCK_PUBLIC_URL=

# Host port for the site. With HTTPS via Caddy (or another proxy on this host) use DUCK_BIND=127.0.0.1 and DUCK_PORT=8080.
DUCK_PORT=8080
DUCK_BIND=0.0.0.0

# 3MF exports run in bounded Node worker threads; keep 1 worker on 1- or 2-core servers.
DUCK_EXPORT_WORKERS=1
DUCK_EXPORT_QUEUE=2

# Maximum active HTTP requests; overload returns 503 with Retry-After: 2.
DUCK_HTTP_LIMIT=64
