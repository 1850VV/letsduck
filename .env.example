# Server edition settings. Copy to .env (never commit .env) and replace both passwords with
# different long random strings, e.g. `openssl rand -base64 24`.
DUCK_MYSQL_PASSWORD=replace-with-a-random-long-password
DUCK_MYSQL_ROOT_PASSWORD=replace-with-another-random-long-password

# Public HTTPS address of the site, once a reverse proxy with a certificate is in front of it.
# Copy-link and poster QR codes use it; leave empty until HTTPS works.
DUCK_PUBLIC_URL=

# Host port for the site (behind your HTTPS reverse proxy). Use DUCK_BIND=127.0.0.1 if the proxy runs on this host.
DUCK_PORT=8080
DUCK_BIND=0.0.0.0

# 3MF exports run in a separate process; 1 worker suits a 2-core server.
DUCK_EXPORT_WORKERS=1
DUCK_EXPORT_QUEUE=2
