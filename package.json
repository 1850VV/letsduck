{
  "name": "letsduck",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling"
  ],
  "scripts": {
    "pack:positions": "tsx scripts/pack_positions.ts",
    "build": "npm run build:core && npm run build:web",
    "typecheck": "npm run build:core && tsc -p frontend/tsconfig.json --noEmit && tsc -p tsconfig.config.json --noEmit && tsc -p scripts/tsconfig.json --noEmit && tsc -p tooling/tsconfig.test.json --noEmit && tsc -p apps/desktop/tsconfig.check.json --noEmit",
    "test": "npm run test:typescript && npm run test:web && npm run test:desktop",
    "test:legacy": "npm run test:web",
    "test:typescript": "npm run build && tsx --test --test-concurrency=1 tooling/test/*.test.ts",
    "audit:publication": "tsx scripts/publication_audit.ts",
    "probe:runtime": "tsx tooling/src/runtime-probe.ts",
    "baseline:capture": "tsx tooling/src/baseline.ts",
    "verify:phase0": "npm run verify:phase6",
    "verify:phase1": "npm run verify:phase6",
    "verify:phase2": "npm run verify:phase6",
    "verify:phase3": "npm run verify:phase6",
    "migrate:database": "tsx tooling/src/migrate-database.ts",
    "verify:phase4": "npm run verify:phase6",
    "start:local": "npm run build && node apps/local/dist/main.js",
    "verify:phase5": "npm run verify:phase6",
    "start:server": "npm run build && node apps/server/dist/main.js",
    "build:core": "tsc -b tsconfig.build.json",
    "build:web": "vite build --config vite.config.ts",
    "pack:geometry": "tsx scripts/pack_geometry.ts",
    "import:assets": "tsx scripts/import_local_assets.ts",
    "import:assembly": "tsx scripts/import_assembly_assets.ts",
    "test:web": "tsx tooling/src/test-web.ts",
    "test:historical": "tsx tooling/src/historical-replay.ts",
    "audit:typescript": "tsx tooling/src/typescript-audit.ts",
    "verify:phase6": "npm run typecheck && npm run test:web -- --require-assets && npm run test:typescript && npm run audit:typescript && npm run audit:publication",
    "prepack:positions": "npm run build:core",
    "prepack:geometry": "npm run build:core",
    "preimport:assets": "npm run build:core",
    "preimport:assembly": "npm run build:core",
    "prebaseline:capture": "npm run build:core",
    "build:desktop": "npm run build && tsc -b apps/desktop && tsc -p apps/desktop/tsconfig.config.json && esbuild apps/desktop/src/preload.cts --bundle --platform=node --format=cjs --external:electron --outfile=apps/desktop/dist/preload.cjs && tsc -p apps/desktop/tsconfig.scripts.json",
    "test:desktop": "npm run build:desktop && tsx --test --test-concurrency=1 apps/desktop/test/*.test.ts",
    "verify:phase7": "npm run verify:phase6 && npm run test:desktop",
    "start:desktop": "npm run build:desktop && electron apps/desktop",
    "setup:electron": "node node_modules/electron/install.js",
    "desktop:prepare": "npm run build:desktop && tsx apps/desktop/scripts/prepare-assets.ts",
    "desktop:icon": "electron apps/desktop/dist-scripts/icon.cjs",
    "package:desktop": "npm run desktop:prepare && npm run desktop:icon && electron-builder --projectDir apps/desktop --config dist-config/electron-builder.cjs --publish never",
    "package:browser": "npm run build && tsx tooling/src/package-browser.ts",
    "fetch:node": "tsx tooling/src/fetch-node-runtime.ts"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@electron/asar": "3.4.1",
    "@types/node": "24.19.2",
    "@types/pngjs": "6.0.5",
    "@types/three": "0.180.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "fastify": "5.12.7",
    "fflate": "0.8.3",
    "meshoptimizer": "1.0.1",
    "mysql2": "3.24.6",
    "playwright": "1.58.2",
    "pngjs": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron@45.0.0": true
  }
}
