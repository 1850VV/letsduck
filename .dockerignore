# Backend root build context: only public build inputs may be sent to Docker.
# In particular assets, .env*, *.db, .ryugi, Git history, dist and node_modules stay outside.
**
!package.json
!package-lock.json
!tsconfig.base.json
!tsconfig.build.json
!LICENSE
!THIRD_PARTY_NOTICES.md
!packages/
!apps/
!tooling/
!backend/
!packages/contracts/
!packages/contracts/package.json
!packages/contracts/tsconfig.json
!packages/contracts/src/
!packages/contracts/src/**
!packages/domain/
!packages/domain/package.json
!packages/domain/tsconfig.json
!packages/domain/src/
!packages/domain/src/**
!packages/exporter/
!packages/exporter/package.json
!packages/exporter/tsconfig.json
!packages/exporter/src/
!packages/exporter/src/**
!packages/storage/
!packages/storage/package.json
!packages/storage/tsconfig.json
!packages/storage/src/
!packages/storage/src/**
!packages/devices/
!packages/devices/package.json
!packages/devices/tsconfig.json
!packages/devices/src/
!packages/devices/src/**
!packages/host/
!packages/host/package.json
!packages/host/tsconfig.json
!packages/host/src/
!packages/host/src/**
!apps/local/
!apps/local/package.json
!apps/local/tsconfig.json
!apps/local/src/
!apps/local/src/**
!apps/server/
!apps/server/package.json
!apps/server/tsconfig.json
!apps/server/src/
!apps/server/src/**
!tooling/package.json
!tooling/tsconfig.json
!tooling/src/
!tooling/src/**
!backend/Dockerfile
# A future file under an allowed src/ directory must not bypass private-data exclusions.
**/.env*
**/*.db
**/*.db-*
**/*.sqlite*
**/*.3mf
**/*.stl
**/*.step
**/*.bin
**/*.bin.gz
**/*.bin.br
**/assets/**
**/.ryugi/**
**/.git/**
**/node_modules/**
**/dist/**
**/__pycache__/**
